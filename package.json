{
  "name": "cove",
  "productName": "Cove",
  "version": "2.0.0-beta",
  "description": "Cove Browser",
  "main": "src/main.js",
  "scripts": {
    "start": "concurrently \"webpack serve --config webpack.config.js\" \"wait-on http://localhost:8080 && electron .\"",
    "build": "webpack --config webpack.config.js",
    "round-icon": "node scripts/round-icon.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "date-fns": "^4.4.0",
    "electron-store": "^8.1.0",
    "i18next": "^26.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.0.0",
    "css-loader": "^6.8.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "sharp": "^0.35.3",
    "style-loader": "^3.3.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^6.0.0"
  },
  "build": {
    "appId": "com.covebrowser.cove",
    "productName": "Cove",
    "copyright": "Copyright © 2026 Cove Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "assets/**/*",
      "icon-256.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon-256.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cove",
      "menuCategory": "Cove Browser",
      "runAfterFinish": true,
      "perMachine": false,
      "unicode": true,
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt"
    },
    "publish": null
  }
}
